# Copy to config.env and fill in. config.env is gitignored (never commit secrets).
export GITLAB_HOST="https://gitlab.com"
export GITLAB_GROUP="my-group/subgroup"      # group path OR numeric id
export GITLAB_TOKEN="REPLACE_WITH_READ_ONLY_TOKEN" # read_api + read_repository, short-lived
export WORK="./work"                         # all outputs live here (gitignored)
